# ---- Public site (already used) ----
NEXT_PUBLIC_SITE_URL=https://theschoolofprophets.site

# ---- Email (Resend) ----
# Sends form notifications and dashboard replies. Optional: without a key the
# site still works and submissions are stored/logged.
RESEND_API_KEY=
FORMS_FROM=TSOP Website <onboarding@resend.dev>
FORMS_INBOX=
NOTIFY_EMAILS=
# Optional webhook (Zapier, Make, Slack, n8n) receiving every submission as JSON.
FORMS_WEBHOOK_URL=

# ---- Supabase (backend: Postgres, Auth, Storage, Realtime) ----
# Dashboard > Project Settings > API. The service-role key is server-only:
# never expose it to the browser, never commit a real .env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web Push (VAPID) ----
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@theschoolofprophets.site

# ---- Optional integrations (feature-flagged, off when blank) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Private calendar feed token (any random string). Bookings feed is at /api/calendar-feed?token=...
CALENDAR_FEED_TOKEN=

# ---- Privacy-friendly analytics. Leave empty to load no analytics at all. ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
