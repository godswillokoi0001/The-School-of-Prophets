# Where form submissions are delivered. Both are optional: without them the site
# still validates submissions and records them in the server log only.
RESEND_API_KEY=
FORMS_INBOX=

# Optional: a webhook (Zapier, Make, Slack, n8n) that receives every submission
# as JSON. Useful if the ministry wants submissions inside a spreadsheet.
FORMS_WEBHOOK_URL=

# Public site URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://theschoolofprophets.org

# Privacy-friendly analytics. Leave empty to load no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
